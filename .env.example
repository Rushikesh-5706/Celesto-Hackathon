# Reprobox — environment configuration
# Copy this file to .env and fill in the secrets.
# Never commit .env. All secrets are marked "replace-me".

# --- Required secrets (fill these before any real run) ---

# Celesto cloud API key (from celesto.ai > Settings > Security > API Keys)
CELESTO_API_KEY=replace-me

# LLM provider — any OpenAI-compatible base URL, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=replace-me

# LLM API key for the provider above
LLM_API_KEY=replace-me

# Model id to use (must support function/tool calling)
LLM_MODEL=replace-me

# --- Optional: provider routing ---

# Which Celesto provider to use: "cloud" for graded runs, "local" for quick smoke tests
CELESTO_PROVIDER=cloud

# Celesto custom or built-in template id (coding-agent has python 3.12 preinstalled)
CELESTO_TEMPLATE_ID=coding-agent

# --- Sandbox sizing ---

# Celesto machine size (Micro = 1 vCPU, 2 GB)
SANDBOX_SIZE=micro

# Billing constants used for cost accounting (set to 0 on a free trial; update if topped up)
SANDBOX_PRICE_PER_HOUR_USD=0.015
LLM_INPUT_PRICE_PER_MTOK_USD=0.0
LLM_OUTPUT_PRICE_PER_MTOK_USD=0.0

# --- Agent behaviour ---

# Maximum number of model turns per run before the run is aborted
AGENT_MAX_TURNS=14

# Hard wall-clock cap per run in seconds (600 = 10 minutes)
RUN_TIMEOUT_S=600

# Timeout per individual step in seconds
STEP_TIMEOUT_S=120

# --- Logging and paths ---

LOG_LEVEL=INFO
REPORTS_DIR=reports
LOGS_DIR=logs
AUDIT_LOG_PATH=logs/commands.jsonl
FIXTURES_DIR=fixtures/cases

# --- Database ---

# Port on the host where the Postgres ledger container is published
LEDGER_PORT=5433

# Full DSN used by the API (inside Docker it points at the ledger service by hostname)
DATABASE_URL=postgresql://ledger:ledger@localhost:5433/ledger

# --- Telemetry ---

# Set to 1 to opt out of Celesto SDK usage telemetry
CELESTO_NO_TELEMETRY=1

# --- API server ---
API_PORT=8080
