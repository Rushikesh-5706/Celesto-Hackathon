CELESTO_PROVIDER=cloud
CELESTO_API_KEY=replace-me
CELESTO_BACKEND=firecracker
LLM_BASE_URL=https://example-llm-host/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger
API_PORT=8080

# Postgres DSN used by host-side harness code and tests
HARNESS_DATABASE_URL=postgresql://ledger:ledger@localhost:5433/ledger
# Host port mapping for Postgres ledger
LEDGER_PORT=5433
# Celesto template id (coding-agent has python 3.12 pre-installed)
CELESTO_TEMPLATE_ID=coding-agent
# Set to 1 to opt out of Celesto SDK usage telemetry
CELESTO_NO_TELEMETRY=1
# Minimum pacing interval between LLM calls in seconds
LLM_MIN_INTERVAL_S=0.0
# Celesto machine size (micro = 1 vCPU, 2 GB)
SANDBOX_SIZE=micro
# Hourly sandbox cost in USD for accounting
SANDBOX_PRICE_PER_HOUR_USD=0.015
# LLM input token price per million in USD
LLM_INPUT_PRICE_PER_MTOK_USD=0.0
# LLM output token price per million in USD
LLM_OUTPUT_PRICE_PER_MTOK_USD=0.0
# Maximum reasoning turns per bug reproduction run
AGENT_MAX_TURNS=14
# Monotonic wall-clock deadline per run in seconds
RUN_TIMEOUT_S=600
# Step timeout in seconds
STEP_TIMEOUT_S=120
# Logging verbosity
LOG_LEVEL=INFO
# Directory containing generated reports
REPORTS_DIR=reports
# Directory for runtime and audit logs
LOGS_DIR=logs
# Path where pre-run audit lines are appended
AUDIT_LOG_PATH=logs/commands.jsonl
# Path to committed audit log served by reports endpoint
COMMITTED_COMMANDS_LOG=logs/commands.jsonl
# Directory where proof bundles and evaluation logs are stored
EVIDENCE_DIR=reports/evidence
# Path to repository README served by reports endpoint
README_PATH=README.md
# Directory containing bug fixture cases
FIXTURES_DIR=fixtures/cases
